# Copy this file to .env and fill in real values. NEVER commit .env.

# Long random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL (local, or the connection string from Supabase / Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/birthday_wall

# MongoDB (local, or the connection string from MongoDB Atlas). Optional.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=birthday_wall

# Cloudinary: copy "API environment variable" from the Cloudinary dashboard.
# Optional: without it, text-only wishes still work.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

DEFAULT_TIMEZONE=Asia/Kolkata

# Set to production on Render (makes the session cookie HTTPS-only)
FLASK_ENV=development

# Only used by the test suite (tests DROP and recreate all tables here!)
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/birthday_wall_test
